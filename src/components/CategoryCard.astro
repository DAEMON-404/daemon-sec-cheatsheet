---
import type { CategoryDef } from '../lib/taxonomy';
import { url } from '../lib/url';
import Icon from './Icon.astro';
interface Props { cat: CategoryDef; count: number }
const { cat, count } = Astro.props;
---
<a class="card pane glow" href={url(cat.slug)} style={`--acc: var(--${cat.accent});`}>
  <div class="pane__bar">
    <span class="pane__dots"><i></i><i></i><i></i></span>
    <span class="pane__label">[{cat.tag}]</span>
  </div>
  <div class="pane__body">
    <h3 class="card-title" style={`color: var(--${cat.accent});`}>{cat.title}</h3>
    <p class="card-desc">{cat.blurb}</p>
    <div class="card-meta">
      <span class="card-count">{count} {count === 1 ? 'sheet' : 'sheets'}</span>
      <span class="card-arrow"><Icon name="arrow" /></span>
    </div>
  </div>
</a>
