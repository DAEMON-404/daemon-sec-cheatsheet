---
import { CATEGORIES } from '../lib/taxonomy';
import { url } from '../lib/url';
interface Props { active?: string }
const { active } = Astro.props;
---
<!-- Twelve chips over a 1px ink ground, so the row reads as one ruled
     strip rather than as twelve floating pills — the same construction as
     the domain grid on the home page. Styling lives in global.css
     (`.cat-nav` / `.cat-chip`) because the sheet pages use it too. -->
<nav class="cat-nav" aria-label="Categories">
  {CATEGORIES.map((c) => (
    <a
      href={url(c.slug)}
      class="cat-chip"
      style={`--acc: var(--${c.accent});`}
      aria-current={active === c.slug ? 'page' : undefined}
    >
      <span class="cat-chip__tag">{c.tag}</span>{c.title}
    </a>
  ))}
</nav>
